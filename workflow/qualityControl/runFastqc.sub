container_image = docker://staphb/fastqc

arguments = $(sample)
executable = fastqc.sh

log = WGS-260210-QUO1021220/log/fastqc_$(sample).log
error = WGS-260210-QUO1021220/err/fastqc_$(sample).err
output = WGS-260210-QUO1021220/out/fastqc_$(sample).out

request_cpus = 6
