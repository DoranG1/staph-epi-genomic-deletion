container_image = docker://staphb/fastqc

arguments = $(sample)
executable = fastqc2.sh

log = WGS-260210-QUO1021220/log/fastqc2_$(sample).log
error = WGS-260210-QUO1021220/err/fastqc2_$(sample).err
